# Copy this file to .env for local development outside Docker.
# Docker Compose sets its own environment variables — .env is for running
# the Go binary directly (e.g. go run ./cmd/server).

PORT=8080
DATABASE_URL=postgres://shardleak:shardleak@localhost:5435/shardleak?sslmode=disable
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:3001
