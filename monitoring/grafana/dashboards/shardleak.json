{
  "title": "ShardLeak",
  "uid": "shardleak-dashboard",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "tags": ["shardleak"],
  "annotations": { "list": [] },
  "links": [],
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Requests / sec",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "shardleak-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "shardleak-prometheus" },
          "expr": "sum(rate(shardleak_requests_total[1m])) by (algorithm)",
          "legendFormat": "{{algorithm}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "P95 Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "shardleak-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "shardleak-prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(shardleak_request_duration_seconds_bucket[1m])) by (le, algorithm))",
          "legendFormat": "p95 {{algorithm}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Allowed / sec",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "shardleak-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "shardleak-prometheus" },
          "expr": "sum(rate(shardleak_allowed_total[1m])) by (algorithm)",
          "legendFormat": "{{algorithm}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "P99 Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "shardleak-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
